@page
@model IndexModel
@{
    ViewData["Title"] = "Overview";
}

<h1>Temperature control</h1>

<div class="row mb-3">
    <div class="col-md-4">
        <section class="card">
            <div class="card-body">
                <h2 class="h6">Process temperature</h2>
                <p class="display-value mb-0">72.4 °C</p>
            </div>
        </section>
    </div>
    <div class="col-md-4">
        <section class="card">
            <div class="card-body">
                <h2 class="h6">Setpoint</h2>
                <p class="display-value mb-0" data-setpoint-display>75.0<span class="small-value"> °C</span></p>
            </div>
        </section>
    </div>
    <div class="col-md-4">
        <section class="card">
            <div class="card-body">
                <h2 class="h6">Controller output</h2>
                <p class="display-value mb-0">38<span class="small-value">%</span></p>
            </div>
        </section>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <section class="card">
            <div class="card-body">
                <h2 class="h5">Temperature trend</h2>
                <p class="text-muted">Sample process temperature and setpoint for the past hour.</p>
                <div class="temperature-chart-wrap">
                    <svg class="temperature-chart" viewBox="0 0 760 280" role="img" aria-labelledby="chart-title chart-description">
                        <title id="chart-title">Temperature trend</title>
                        <desc id="chart-description">Sample process temperature rises toward a 75 degree Celsius setpoint.</desc>
                        <g class="chart-grid">
                            <line x1="52" y1="30" x2="744" y2="30" />
                            <line x1="52" y1="82" x2="744" y2="82" />
                            <line x1="52" y1="134" x2="744" y2="134" />
                            <line x1="52" y1="186" x2="744" y2="186" />
                            <line x1="52" y1="238" x2="744" y2="238" />
                        </g>
                        <g class="chart-labels">
                            <text x="0" y="34">90°</text>
                            <text x="0" y="86">82°</text>
                            <text x="0" y="138">74°</text>
                            <text x="0" y="190">66°</text>
                            <text x="0" y="242">58°</text>
                            <text x="52" y="269">−60 min</text>
                            <text x="225" y="269">−45 min</text>
                            <text x="398" y="269">−30 min</text>
                            <text x="571" y="269">−15 min</text>
                            <text x="744" y="269" text-anchor="end">Now</text>
                        </g>
                        <line class="chart-setpoint" x1="52" y1="127" x2="744" y2="127" />
                        <path class="chart-area" d="M52 211 C84 207 97 202 118 204 S153 196 175 200 S207 183 232 188 S265 174 289 182 S322 164 348 172 S378 156 402 162 S433 148 458 157 S487 141 513 151 S542 133 568 144 S596 137 624 144 S656 128 681 139 S716 121 744 132 L744 238 L52 238 Z" />
                        <path class="chart-process" d="M52 211 C84 207 97 202 118 204 S153 196 175 200 S207 183 232 188 S265 174 289 182 S322 164 348 172 S378 156 402 162 S433 148 458 157 S487 141 513 151 S542 133 568 144 S596 137 624 144 S656 128 681 139 S716 121 744 132" />
                        <circle class="chart-current-point" cx="744" cy="132" r="5" />
                    </svg>
                </div>
            </div>
        </section>
    </div>
    <div class="col-lg-4">
        <section class="card">
            <div class="card-body">
                <h2 class="h5">Setpoint control</h2>
                <form id="setpoint-form">
                    <label class="form-label" for="setpoint-input">Setpoint (°C)</label>
                    <div class="setpoint-control">
                        <input id="setpoint-input" name="setpoint" class="form-control" type="number" value="75.0" min="0" max="200" step="0.5" required />
                        <div class="setpoint-stepper">
                            <button class="btn btn-outline-secondary" type="button" data-setpoint-step="0.5" aria-label="Increase setpoint by 0.5 degrees">+</button>
                            <button class="btn btn-outline-secondary" type="button" data-setpoint-step="-0.5" aria-label="Decrease setpoint by 0.5 degrees">−</button>
                        </div>
                    </div>
                    <button class="btn btn-primary" type="submit">Apply setpoint</button>
                    <span id="setpoint-feedback" class="small" aria-live="polite"></span>
                </form>
                <hr />
                <p class="mb-2">Loop state: <strong id="loop-state-label">Running</strong></p>
                <button id="loop-toggle" class="btn btn-outline-secondary btn-sm" type="button" aria-pressed="true">Pause</button>
                <p class="small text-muted mt-3 mb-0">Preview only. No commands are sent to a controller.</p>
            </div>
        </section>
    </div>
</div>
