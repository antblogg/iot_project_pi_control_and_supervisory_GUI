@page
@model IndexModel
@{
    ViewData["Title"] = "Overview";
}

<h1>Temperature analytics</h1>
<p class="text-muted">Temperature readings from the past minute.</p>

<section class="card chart-card mb-3">
    <div class="card-body">
        <div class="chart-header">
            <div>
                <h2 class="h5 mb-0">Temperature trend</h2>
                <p class="text-muted mb-0">Process temperature over the past 60 seconds with a 30.0 °C reference line.</p>
            </div>
            <div class="chart-legend" aria-label="Chart legend">
                <span class="legend-item"><span class="legend-swatch legend-process"></span>Process temperature</span>
                <span class="legend-item"><span class="legend-swatch legend-reference"></span>Reference (30.0 °C)</span>
            </div>
        </div>
        <div class="temperature-chart-wrap temperature-chart-wrap-prominent">
            <svg class="temperature-chart" viewBox="0 0 760 280" role="img" aria-labelledby="chart-title chart-description">
                <title id="chart-title">Temperature trend for the past minute</title>
                <desc id="chart-description">Process temperature rises from about 27 degrees Celsius to about 30.5 degrees Celsius over the past minute, settling near a 30 degree Celsius reference line.</desc>
                <g class="chart-grid">
                    <line x1="52" y1="30" x2="744" y2="30" />
                    <line x1="52" y1="82" x2="744" y2="82" />
                    <line x1="52" y1="134" x2="744" y2="134" />
                    <line x1="52" y1="186" x2="744" y2="186" />
                    <line x1="52" y1="238" x2="744" y2="238" />
                </g>
                <g class="chart-labels">
                    <text x="0" y="34">36°</text>
                    <text x="0" y="86">33°</text>
                    <text x="0" y="138">30°</text>
                    <text x="0" y="190">27°</text>
                    <text x="0" y="242">24°</text>
                    <text x="52" y="269">−60 s</text>
                    <text x="225" y="269">−45 s</text>
                    <text x="398" y="269">−30 s</text>
                    <text x="571" y="269">−15 s</text>
                    <text x="744" y="269" text-anchor="end">Now</text>
                </g>
                <line class="chart-setpoint" x1="52" y1="138" x2="744" y2="138" />
                <path class="chart-area" d="M52 190 C81 190, 110 186, 138 182 S196 177, 225 174 S268 169, 312 164 S355 159, 398 154 S441 150, 485 146 S528 143, 571 141 S614 138, 658 136 S701 134, 744 133 L744 238 L52 238 Z" />
                <path class="chart-process" d="M52 190 C81 190, 110 186, 138 182 S196 177, 225 174 S268 169, 312 164 S355 159, 398 154 S441 150, 485 146 S528 143, 571 141 S614 138, 658 136 S701 134, 744 133" />
                <circle class="chart-current-point" cx="744" cy="133" r="5" />
            </svg>
        </div>
    </div>
</section>

<section class="card mb-3">
    <div class="card-body">
        <h2 class="h5">Database connection</h2>
        <p class="mb-2">
            Status:
            <strong class="@(Model.IsDatabaseConnected ? "text-success" : "text-muted")">
                @(Model.IsDatabaseConnected ? "Connected" : "Not connected")
            </strong>
        </p>
        <p class="text-muted">Enter the database password to connect.</p>

        @if (!string.IsNullOrWhiteSpace(Model.ConnectionMessage))
        {
            <p class="@(Model.ConnectionMessageIsError ? "text-error" : "text-success")" role="status">@Model.ConnectionMessage</p>
        }

        @if (Model.IsDatabaseConnected)
        {
            <form method="post" asp-page-handler="Disconnect" class="connection-form">
                <button class="btn btn-outline-secondary" type="submit">Disconnect</button>
            </form>
        }
        else
        {
            <form method="post" asp-page-handler="Connect" class="connection-form">
                <label class="form-label" for="database-password">Database password</label>
                <div class="connection-form-row">
                    <input id="database-password" asp-for="DatabasePassword" class="form-control" type="password" autocomplete="off" />
                    <button class="btn btn-primary" type="submit">Connect</button>
                </div>
            </form>
        }
    </div>
</section>

<div class="row mb-3">
    <div class="col-md-3">
        <section class="card">
            <div class="card-body">
                <h2 class="h6">Current</h2>
                <p class="display-value mb-0">@Model.Analytics.CurrentTemperatureC.ToString("0.0")<span class="small-value"> °C</span></p>
            </div>
        </section>
    </div>
    <div class="col-md-3">
        <section class="card">
            <div class="card-body">
                <h2 class="h6">1-minute average</h2>
                <p class="display-value mb-0">@Model.Analytics.AverageTemperatureC.ToString("0.0")<span class="small-value"> °C</span></p>
            </div>
        </section>
    </div>
    <div class="col-md-3">
        <section class="card">
            <div class="card-body">
                <h2 class="h6">Minimum</h2>
                <p class="display-value mb-0">@Model.Analytics.MinTemperatureC.ToString("0.0")<span class="small-value"> °C</span></p>
            </div>
        </section>
    </div>
    <div class="col-md-3">
        <section class="card">
            <div class="card-body">
                <h2 class="h6">Maximum</h2>
                <p class="display-value mb-0">@Model.Analytics.MaxTemperatureC.ToString("0.0")<span class="small-value"> °C</span></p>
            </div>
        </section>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <section class="card">
            <div class="card-body">
                <h2 class="h5">Period summary</h2>
                <p class="text-muted">Key statistics for the displayed time window.</p>
                <dl class="analytics-list">
                    <div class="analytics-item">
                        <dt>Temperature range</dt>
                        <dd>@Model.Analytics.TemperatureRangeC.ToString("0.0") °C</dd>
                    </div>
                    <div class="analytics-item">
                        <dt>Average rate of change</dt>
                        <dd>@Model.Analytics.AverageRateOfChangeCPerSecond.ToString("+0.00;-0.00;0.00") °C/s</dd>
                    </div>
                    <div class="analytics-item">
                        <dt>Samples in window</dt>
                        <dd>@Model.Analytics.SampleCount</dd>
                    </div>
                    <div class="analytics-item">
                        <dt>Latest reading</dt>
                        <dd>@Model.Analytics.LatestReadingText</dd>
                    </div>
                </dl>
            </div>
        </section>
    </div>
</div>
