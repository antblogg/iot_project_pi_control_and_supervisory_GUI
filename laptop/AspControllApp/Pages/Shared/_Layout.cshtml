@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Temperature Control</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar">
            <div class="container navbar-content">
                <a class="navbar-brand" asp-page="/Index">SCADA Monitoring System</a>
                <div class="navbar-spacer"></div>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form method="post" asp-page="/Login" asp-page-handler="Logout" class="logout-form">
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Sign out</button>
                    </form>
                }
                <!--
                <div class="navbar-nav">
                    <a class="nav-link @(currentPage == "/Index" ? "active" : "")"
                       asp-page="/Index"
                       aria-current="@(currentPage == "/Index" ? "page" : null)">Overview</a>
                    <a class="nav-link @(currentPage == "/Settings" ? "active" : "")"
                       asp-page="/Settings"
                       aria-current="@(currentPage == "/Settings" ? "page" : null)">Advanced settings</a>
                </div>
                -->
            </div>
        </nav>
    </header>
    <div class="container">
        <main class="main-content">
            @RenderBody()
        </main>
    </div>
    <footer class="footer">
        <div class="container">
            Temperature analytics
        </div>
    </footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
